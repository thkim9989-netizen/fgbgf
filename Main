const STORAGE_KEY = "calisthenicsProgramState_v1";
let state = null;
let activeDayIdx = 0;

function defaultState(){
  const days = {};
  PROGRAM.forEach(day=>{
    const exReps = {};
    day.exercises.forEach((ex,i)=>{
      exReps[i] = new Array(ex.sets).fill(null); // null = not logged; number for reps; true for hold-done
    });
    days[day.id] = { reps: exReps, note: "", completed: false };
  });
  return {
    weekNumber: 1,
    weeksDone: 0,
    days,
    history: [] // {week, dayId, dayName, date, note, setsHit, setsTotal}
  };
}

function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return defaultState();
    const parsed = JSON.parse(raw);
    // basic shape check / migration safety
    if(!parsed.days) return defaultState();
    PROGRAM.forEach(day=>{
      if(!parsed.days[day.id]){
        const exReps = {};
        day.exercises.forEach((ex,i)=>{ exReps[i] = new Array(ex.sets).fill(null); });
        parsed.days[day.id] = { reps: exReps, note:"", completed:false };
      }
    });
    if(typeof parsed.weeksDone !== "number") parsed.weeksDone = 0;
    if(typeof parsed.weekNumber !== "number") parsed.weekNumber = 1;
    if(!Array.isArray(parsed.history)) parsed.history = [];
    return parsed;
  }catch(e){
    console.error("Load failed, using fresh state", e);
    return defaultState();
  }
}

let saveTimeout = null;
function saveState(){
  try{
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    showToast();
  }catch(e){
    console.error("Save failed", e);
  }
}
function showToast(){
  const t = document.getElementById("saveToast");
  clearTimeout(saveTimeout);
  t.classList.add("show");
  saveTimeout = setTimeout(()=> t.classList.remove("show"), 900);
}

/* ---------- RENDER ---------- */

function renderTabs(){
  const row = document.getElementById("tabsRow");
  row.innerHTML = "";
  PROGRAM.forEach((day, idx)=>{
    const btn = document.createElement("div");
    btn.className = "tab" + (idx===activeDayIdx ? " active" : "");
    btn.innerHTML = `Day ${idx+1}<span class="d">${day.name.split(" ")[0].slice(0,4).toUpperCase()}</span>`;
    if(state.days[day.id].completed){
      const chk = document.createElement("div");
      chk.className = "check";
      chk.textContent = "✓";
      btn.appendChild(chk);
    }
    btn.addEventListener("click", ()=>{
      activeDayIdx = idx;
      renderAll();
    });
    row.appendChild(btn);
  });
}

function gradeInput(value, min, max){
  if(value === null || value === "" || isNaN(value)) return "";
  const v = Number(value);
  if(v >= min) return "hit";
  return "miss";
}

function renderDayPanels(){
  const container = document.getElementById("dayPanels");
  container.innerHTML = "";
  PROGRAM.forEach((day, idx)=>{
    const panel = document.createElement("div");
    panel.className = "day-panel" + (idx===activeDayIdx ? " active" : "");
    panel.id = "panel-"+day.id;

    let html = `<div class="day-head">
        <div class="day-title"><span class="num">D${idx+1}</span> — ${day.name}</div>
      </div>`;

    if(day.warmup){
      html += `<div class="warmup"><b>Warm-up · 5 min</b>${day.warmup}</div>`;
    }
    if(day.note){
      html += `<div class="progression-note">${day.note}</div>`;
    }

    day.exercises.forEach((ex, exIdx)=>{
      const dayState = state.days[day.id];
      const logged = dayState.reps[exIdx];
      html += `<div class="exercise ${ex.star ? 'star' : ''}">
        <div class="ex-head">
          <div>
            <div class="ex-name">${ex.star ? '<span class="star-mark">★</span>' : ''}${ex.name}${ex.db ? '<span class="db-tag">DB</span>' : ''}</div>
            <div class="ex-meta">${ex.meta}</div>
          </div>
          <div class="ex-target">${ex.target}</div>
        </div>`;

      const instrText = EX_INSTR[ex.name];
      if(instrText){
        const instrId = "instr-"+day.id+"-"+exIdx;
        html += `<button class="instr-toggle" data-target="${instrId}" type="button">How to <span class="arrow">\u25BC</span></button>
          <div class="ex-instr" id="${instrId}">${instrText}</div>`;
      }

      if(ex.type === "reps"){
        html += `<div class="sets-row">`;
        for(let s=0; s<ex.sets; s++){
          const val = logged[s];
          const cls = gradeInput(val, ex.min, ex.max);
          html += `<div class="set-box">
            <span class="set-lbl">SET ${s+1}</span>
            <input type="number" inputmode="numeric" pattern="[0-9]*" min="0"
              class="set-input ${cls}"
              data-day="${day.id}" data-ex="${exIdx}" data-set="${s}"
              value="${val===null ? '' : val}" placeholder="0" />
          </div>`;
        }
        html += `</div>`;
      } else {
        html += `<div class="hold-row">`;
        for(let s=0; s<ex.sets; s++){
          const done = logged[s] === true;
          html += `<div class="hold-pill ${done ? 'done':''}" data-day="${day.id}" data-ex="${exIdx}" data-set="${s}">
            <span>${done ? '✓' : 'SET '+(s+1)}</span>
          </div>`;
        }
        html += `</div>`;
      }

      html += `</div>`;
    });

    html += `<div class="day-notes">
        <label>Notes — how did it feel?</label>
        <textarea data-day="${day.id}" placeholder="Soreness, form breakdown, pain flags, energy...">${state.days[day.id].note || ""}</textarea>
      </div>`;

    const isComplete = state.days[day.id].completed;
    html += `<button class="complete-day-btn ${isComplete ? 'done' : ''}" data-day="${day.id}">
        ${isComplete ? '✓ Day Logged' : 'Mark Day Complete'}
      </button>`;

    panel.innerHTML = html;
    container.appendChild(panel);
  });

  attachDayPanelListeners();
}

function attachDayPanelListeners(){
  document.querySelectorAll(".instr-toggle").forEach(btn=>{
    btn.addEventListener("click", (e)=>{
      const targetId = e.currentTarget.dataset.target;
      const panel = document.getElementById(targetId);
      const nowOpen = !panel.classList.contains("open");
      panel.classList.toggle("open", nowOpen);
      e.currentTarget.classList.toggle("open", nowOpen);
    });
  });

  document.querySelectorAll(".set-input").forEach(input=>{
    input.addEventListener("input", (e)=>{
      const {day, ex, set} = e.target.dataset;
      const exDef = PROGRAM.find(d=>d.id===day).exercises[ex];
      let val = e.target.value;
      state.days[day].reps[ex][set] = val === "" ? null : Number(val);
      const cls = gradeInput(val, exDef.min, exDef.max);
      e.target.className = "set-input " + cls;
      saveState();
      renderStatsAndProgress();
    });
  });

  document.querySelectorAll(".hold-pill").forEach(pill=>{
    pill.addEventListener("click", (e)=>{
      const target = e.currentTarget;
      const {day, ex, set} = target.dataset;
      const current = state.days[day].reps[ex][set] === true;
      state.days[day].reps[ex][set] = !current;
      target.classList.toggle("done", !current);
      target.querySelector("span").textContent = !current ? "✓" : "SET "+(Number(set)+1);
      saveState();
      renderStatsAndProgress();
    });
  });

  document.querySelectorAll(".day-notes textarea").forEach(ta=>{
    ta.addEventListener("input", (e)=>{
      state.days[e.target.dataset.day].note = e.target.value;
      saveState();
    });
  });

  document.querySelectorAll(".complete-day-btn").forEach(btn=>{
    btn.addEventListener("click", (e)=>{
      const dayId = e.target.dataset.day;
      const dayDef = PROGRAM.find(d=>d.id===dayId);
      const dayState = state.days[dayId];
      const wasComplete = dayState.completed;
      dayState.completed = !wasComplete;

      if(!wasComplete){
        // compute sets hit / total for the log entry
        let setsTotal = 0, setsHit = 0;
        dayDef.exercises.forEach((ex, exIdx)=>{
          dayState.reps[exIdx].forEach(v=>{
            setsTotal++;
            if(ex.type === "hold"){
              if(v === true) setsHit++;
            } else {
              if(v !== null && Number(v) >= ex.min) setsHit++;
            }
          });
        });
        state.history.unshift({
          week: state.weekNumber,
          dayId: dayId,
          dayName: dayDef.name,
          dayIndex: PROGRAM.findIndex(d=>d.id===dayId) + 1,
          date: new Date().toLocaleDateString(undefined,{month:'short',day:'numeric'}),
          note: dayState.note,
          setsHit, setsTotal
        });
        checkWeekCompletion();
      } else {
        // remove the most recent matching history entry for this week/day
        const idx = state.history.findIndex(h=>h.dayId===dayId && h.week===state.weekNumber);
        if(idx > -1) state.history.splice(idx,1);
      }

      saveState();
      renderAll();
    });
  });
}

function checkWeekCompletion(){
  const allDone = PROGRAM.every(d=>state.days[d.id].completed);
  if(allDone){
    state.weeksDone += 1;
  }
}

function renderStatsAndProgress(){
  // days done this week
  const daysDone = PROGRAM.filter(d=>state.days[d.id].completed).length;
  document.getElementById("statDaysDone").textContent = `${daysDone}/7`;

  // full exercises: an exercise counts "full" if every set meets/exceeds target (reps) or is marked done (hold)
  let fullEx = 0;
  PROGRAM.forEach(day=>{
    day.exercises.forEach((ex, exIdx)=>{
      const logged = state.days[day.id].reps[exIdx];
      const allSetsGood = logged.every(v=>{
        if(ex.type === "hold") return v === true;
        return v !== null && Number(v) >= ex.min;
      });
      if(allSetsGood) fullEx++;
    });
  });
  document.getElementById("statFullEx").textContent = fullEx;

  document.getElementById("statWeeks").textContent = state.weeksDone;

  // overall % complete for the week = logged sets / total sets across all days
  let totalSets = 0, loggedSets = 0;
  PROGRAM.forEach(day=>{
    day.exercises.forEach((ex, exIdx)=>{
      const logged = state.days[day.id].reps[exIdx];
      logged.forEach(v=>{
        totalSets++;
        if(v !== null) loggedSets++;
      });
    });
  });
  const pct = totalSets ? Math.round((loggedSets/totalSets)*100) : 0;
  document.getElementById("statPct").textContent = `${pct}%`;

  document.getElementById("weekNumDisplay").textContent = state.weekNumber;

  // progress bar for the active day
  const activeDay = PROGRAM[activeDayIdx];
  let dayTotal = 0, dayLogged = 0;
  activeDay.exercises.forEach((ex, exIdx)=>{
    const logged = state.days[activeDay.id].reps[exIdx];
    logged.forEach(v=>{
      dayTotal++;
      if(v !== null) dayLogged++;
    });
  });
  const dayPct = dayTotal ? (dayLogged/dayTotal)*100 : 0;
  document.getElementById("progressFill").style.width = dayPct + "%";
  document.getElementById("progressFraction").textContent = `${dayLogged}/${dayTotal} sets`;
  document.getElementById("progressDayLabel").textContent = `Day ${activeDayIdx+1} Progress`;
}

function renderHistory(){
  const log = document.getElementById("historyLog");
  if(state.history.length === 0){
    log.innerHTML = `<div class="history-empty">No days logged yet. Complete a day to start your history.</div>`;
    return;
  }
  log.innerHTML = state.history.slice(0, 40).map(h=>{
    return `<div class="history-item">
      <div class="hi-top"><b>Wk${h.week} · Day ${h.dayIndex} — ${h.dayName}</b><span>${h.date}</span></div>
      <div class="hi-top" style="margin-bottom:${h.note ? '6px' : '0'}"><span>${h.setsHit}/${h.setsTotal} sets on target</span></div>
      ${h.note ? `<div class="hi-note">${escapeHtml(h.note)}</div>` : ''}
    </div>`;
  }).join("");
}

function escapeHtml(str){
  const div = document.createElement("div");
  div.textContent = str;
  return div.innerHTML;
}

function renderAll(){
  renderTabs();
  renderDayPanels();
  renderStatsAndProgress();
  renderHistory();
}

/* ---------- RESET WEEK ---------- */
document.getElementById("resetWeekBtn").addEventListener("click", ()=>{
  document.getElementById("confirmOverlay").classList.add("show");
});
document.getElementById("confirmCancel").addEventListener("click", ()=>{
  document.getElementById("confirmOverlay").classList.remove("show");
});
document.getElementById("confirmOk").addEventListener("click", ()=>{
  // clear reps/notes/completed but keep history + weeksDone, bump week number
  PROGRAM.forEach(day=>{
    const exReps = {};
    day.exercises.forEach((ex,i)=>{ exReps[i] = new Array(ex.sets).fill(null); });
    state.days[day.id] = { reps: exReps, note:"", completed:false };
  });
  state.weekNumber += 1;
  activeDayIdx = 0;
  saveState();
  renderAll();
  document.getElementById("confirmOverlay").classList.remove("show");
});

/* ---------- INIT ---------- */
state = loadState();
renderAll();
</script>
</body>
</html>
