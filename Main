<script>
const sb = window.supabase.createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY);
const appEl = document.getElementById('app');
const COLORS = { rose:'#bc6d84', roseLine:'#dfc7cd', sage:'#6f8f66', ink:'#3a2e33', sub:'#8d7e83', paper:'#fffefc' };
let currentUser = null;
const DEMO_EMAIL = window.DEMO_FOSTERER_EMAIL || '';

function esc(s){ return String(s??'').replace(/[&<>"\']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function displayName(cat){
  if(!cat) return '';
  const n = (cat.name||'').trim();
  if(n && n.toLowerCase()!=='no name') return n;
  return cat.animal_id ? cat.animal_id : (n || 'Unnamed');
}
function fmtDate(d){ if(!d) return ''; const dt=new Date(d); return dt.toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }); }
function fmtDateShort(d){ if(!d) return ''; const dt=new Date(d); return dt.toLocaleDateString('en-US', { month:'short', day:'numeric' }); }

function daysBetween(a,b){ return Math.max(0, Math.round((b-a)/86400000)); }
function ageString(dobStr){
  if(!dobStr) return null;
  const days = daysBetween(new Date(dobStr), new Date());
  if(days < 14) return days+' day'+(days===1?'':'s')+' old';
  const weeks = Math.floor(days/7);
  if(weeks < 12) return weeks+' week'+(weeks===1?'':'s')+' old';
  const months = Math.floor(days/30.4);
  return months+' month'+(months===1?'':'s')+' old';
}
function daysInCareString(startStr){
  if(!startStr) return null;
  const days = daysBetween(new Date(startStr), new Date());
  return days+' day'+(days===1?'':'s')+' in foster care';
}

function growthChartSVG(weights){
  if(!weights || weights.length < 2) return null;
  const sorted = weights.slice().sort((a,b)=> new Date(a.measured_at)-new Date(b.measured_at));
  const W=320,H=140,padL=30,padR=14,padT=22,padB=28;
  const vals = sorted.map(w=>w.weight_lb);
  const min = Math.min(...vals), max = Math.max(...vals);
  const range = (max-min) || 1;
  const n = sorted.length;
  const xAt = i => n===1 ? (padL+(W-padL-padR)/2) : padL + i*(W-padL-padR)/(n-1);
  const yAt = v => H-padB - ((v-min)/range)*(H-padT-padB);
  const pts = sorted.map((w,i)=>({x:xAt(i), y:yAt(w.weight_lb), w}));
  const path = pts.map((p,i)=> (i===0?'M':'L')+p.x.toFixed(1)+','+p.y.toFixed(1)).join(' ');
  const grid = [0,.5,1].map(t=>{
    const gy = (padT + t*(H-padT-padB)).toFixed(1);
    return `<line x1="${padL}" y1="${gy}" x2="${W-padR}" y2="${gy}" stroke="${COLORS.roseLine}" stroke-width="1" stroke-dasharray="1 4"/>`;
  }).join('');
  const dots = pts.map(p=>`
    <text x="${p.x.toFixed(1)}" y="${(p.y-10).toFixed(1)}" text-anchor="middle" font-family="ui-monospace,monospace" font-size="9" fill="${COLORS.ink}">${p.w.weight_lb.toFixed(2)}</text>
    <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4" fill="${COLORS.paper}" stroke="${COLORS.rose}" stroke-width="2"/>
    <text x="${p.x.toFixed(1)}" y="${H-9}" text-anchor="middle" font-family="ui-monospace,monospace" font-size="8" fill="${COLORS.sub}">${fmtDateShort(p.w.measured_at)}</text>
  `).join('');
  return `<svg viewBox="0 0 ${W} ${H}" class="growth-svg" role="img" aria-label="Weight in pounds over time">${grid}<path d="${path}" fill="none" stroke="${COLORS.rose}" stroke-width="2"/>${dots}</svg>`;
}

function groupByLitter(cats){
  const order = [], map = new Map();
  cats.forEach(c=>{
    const key = c.litter_id || ('solo-'+c.id);
    if(!map.has(key)){ map.set(key, []); order.push(key); }
    map.get(key).push(c);
  });
  return order.map(k=>map.get(k));
}

// Guest home header removed per request — the album grid leads the page directly.
const HERO = '';

function heroStatsHTML(cats, photos, weights){
  const kittenCount = cats.length;
  const photoCount = photos.length;
  let totalGain = 0, gainCats = 0;
  groupByLitter(cats); // no-op, keeps litter helper exercised for future multi-litter growth
  cats.forEach(c=>{
    const ws = weights.filter(w=>w.cat_id===c.id).sort((a,b)=> new Date(a.measured_at)-new Date(b.measured_at));
    if(ws.length>=2){ totalGain += (ws[ws.length-1].weight_lb - ws[0].weight_lb); gainCats++; }
  });
  const chips = [
    `<div class="tag big stat-tag"><span class="n">${kittenCount}</span><span class="l">in the album</span></div>`,
    `<div class="tag big stat-tag"><span class="n">${photoCount}</span><span class="l">photos logged</span></div>`
  ];
  if(gainCats>0) chips.push(`<div class="tag big stat-tag sage"><span class="n">+${totalGain.toFixed(1)} lb</span><span class="l">gained combined</span></div>`);
  return chips.join('');
}

function litterHeadHTML(group){
  if(group.length < 2) return '';
  const c = group[0];
  const litterId = c.litter_id;
  return `<div class="litter-head">
    <div class="row">
      <span class="tag">Litter ${esc(litterId)}</span>
      <span class="tag sage">${group.length} kittens</span>
    </div>
    <p>${group.length} orphaned kittens brought in together on ${fmtDate(c.foster_start)} from Broward County Animal Care, now growing side by side in the same foster home.</p>
  </div>`;
}

function catCardHTML(c){
  const statusTag = c.status==='adopted' ? '<span class="tag sage">Adopted</span>' : '<span class="tag">Fostering</span>';
  const age = ageString(c.date_of_birth);
  return `<div class="cat-card" data-cat="${c.id}" tabindex="0" role="button" aria-label="View ${esc(displayName(c))}'s growth story">
    <div class="photo-wrap">
      ${c.cover_photo?`<img class="thumb" src="${c.cover_photo}" alt="${esc(displayName(c))}">`:`<div class="thumb ph">No photo</div>`}
      ${statusTag}
    </div>
    <div class="body">
      <div class="name">${esc(displayName(c))}</div>
      <div class="meta">${esc(c.breed||'')}${c.animal_id?' &middot; '+esc(c.animal_id):''}</div>
      ${age?`<div class="age">${c.status==='adopted'?'Was':''} <b>${age}</b></div>`:''}
    </div>
  </div>`;
}

async function renderList(){
  appEl.innerHTML = `${HERO}<div class="spinner-wrap"><div class="spinner"></div></div>`;
  const [{ data: cats, error }, { data: photos }, { data: weights }] = await Promise.all([
    sb.from('cats').select('*').order('created_at', { ascending:false }),
    sb.from('photos').select('*'),
    sb.from('weights').select('*')
  ]);
  if(error){
    appEl.innerHTML = `${HERO}<div class="empty">Couldn't load the growth album.<br>${esc(error.message)}</div>`;
    return;
  }
  if(!cats || cats.length===0){
    appEl.innerHTML = `${HERO}<div class="empty">No kittens are logged yet. New arrivals are added here as soon as their foster placement begins.</div>`;
    return;
  }
  const litters = groupByLitter(cats);
  const sections = litters.map(group => `
    ${litterHeadHTML(group)}
    <div class="grid">${group.map(catCardHTML).join('')}</div>
  `).join('');

  appEl.innerHTML = `
    ${HERO}
    ${sections}
    ${aboutStripHTML()}
    ${await resourcesHTML()}
    ${siteEndHTML()}
  `;
  const statsHost = document.getElementById('hero-stats');
  if(statsHost) statsHost.innerHTML = heroStatsHTML(cats, photos||[], weights||[]);
  appEl.querySelectorAll('[data-cat]').forEach(el=>{
    const go = ()=>{ location.hash = `cat=${el.dataset.cat}`; };
    el.addEventListener('click', go);
    el.addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); go(); } });
  });
}

function statCardsHTML(cat, weights){
  const ws = weights.slice().sort((a,b)=> new Date(a.measured_at)-new Date(b.measured_at));
  const cards = [];
  const age = ageString(cat.date_of_birth);
  if(age) cards.push(`<div class="stat-card"><div class="num">${age.split(' ')[0]}</div><div class="lab">${age.split(' ').slice(1).join(' ')}</div></div>`);
  if(ws.length) cards.push(`<div class="stat-card"><div class="num">${ws[ws.length-1].weight_lb.toFixed(2)} lb</div><div class="lab">Current weight</div></div>`);
  if(ws.length>=2){
    const gain = ws[ws.length-1].weight_lb - ws[0].weight_lb;
    cards.push(`<div class="stat-card"><div class="num">+${gain.toFixed(2)} lb</div><div class="lab">Since intake</div></div>`);
  }
  const days = daysInCareString(cat.foster_start);
  if(days) cards.push(`<div class="stat-card"><div class="num">${days.split(' ')[0]}</div><div class="lab">Days in foster care</div></div>`);
  return cards.length ? `<div class="stat-grid">${cards.join('')}</div>` : '';
}

function growthSectionHTML(weights){
  if(!weights || weights.length===0) return '';
  const svg = growthChartSVG(weights);
  const inner = svg
    ? svg
    : `<div class="growth-note">Weigh-ins will appear here once a second reading is logged.</div>`;
  return `
    <div class="section-head"><span class="eyebrow">Weigh-in log</span><h2>Growth Chart</h2></div>
    <div class="growth-card">${inner}</div>
  `;
}

function littermatesHTML(cat, allCats){
  if(!cat.litter_id) return '';
  const siblings = allCats.filter(c=> c.id!==cat.id && c.litter_id===cat.litter_id);
  if(!siblings.length) return '';
  const cards = siblings.map(s=>`
    <a class="lm-card" href="#cat=${s.id}">
      ${s.cover_photo?`<img src="${s.cover_photo}" alt="${esc(displayName(s))}">`:`<div class="ph">No photo</div>`}
      <div class="lm-name">${esc(displayName(s))}</div>
      <div class="lm-meta">${s.status==='adopted'?'Adopted':'Fostering'}</div>
    </a>
  `).join('');
  return `
    <div class="section-head"><span class="eyebrow">Growing up together</span><h2>Littermates</h2></div>
    <div class="littermates">${cards}</div>
  `;
}

async function resourcesHTML(){
  const { data: resources } = await sb.from('resources').select('*');
  if(!resources || !resources.length) return '';
  const groups = { emergency:'If you need urgent help', vet:'Recommended vet clinics' };
  const blocks = Object.keys(groups).map(type=>{
    const rows = resources.filter(r=>r.type===type);
    if(!rows.length) return '';
    const rowsHtml = rows.map(r=>`
      <div class="res-row">
        <div><span class="name">${esc(r.name)}</span>${r.note?`<span class="note">${esc(r.note)}${r.address?' · '+esc(r.address):''}</span>`:''}</div>
        <a class="phone" href="tel:${esc(r.phone.replace(/[^0-9+]/g,''))}">${esc(r.phone)}</a>
      </div>`).join('');
    return `<div class="res-group"><div class="rg-title">${groups[type]}</div>${rowsHtml}</div>`;
  }).join('');
  return `<div class="resources"><h3>Resources</h3>${blocks}</div>`;
}

function aboutStripHTML(){
  return '';
}

function siteEndHTML(){
  const year = new Date().getFullYear();
  return `<footer class="site-end">&copy; ${year} Broward County Animal Care &middot; Foster Program
    <span class="priv">Foster volunteers' personal contact details are kept private. Adoption inquiries always route through the shelter's adoption team.</span>
  </footer>`;
}

async function renderDetail(catId){
  appEl.innerHTML = `<div class="spinner-wrap"><div class="spinner"></div></div>`;
  const { data: cat, error: catErr } = await sb.from('cats').select('*').eq('id', catId).single();
  if(catErr || !cat){
    appEl.innerHTML = `<div class="empty">We couldn't find that kitten. They may have been adopted and moved off this page.<br><span class="back-link" data-home>&lsaquo; Back to all kittens</span></div>`;
    appEl.querySelector('[data-home]').addEventListener('click', ()=>{ location.hash=''; });
    return;
  }
  const [{ data: photos }, { data: weights }, { data: allCats }, { data: profiles }] = await Promise.all([
    sb.from('photos').select('*').eq('cat_id', catId).order('taken_at', { ascending:true }),
    sb.from('weights').select('*').eq('cat_id', catId),
    sb.from('cats').select('*'),
    sb.from('profiles').select('*').eq('email', cat.fosterer_email)
  ]);

  const timeline = (photos||[]).length ? `
    <div class="section-head"><span class="eyebrow">Photo trail</span><h2>Growth Timeline</h2></div>
    <div class="timeline">${photos.map(p=>`
    <div class="tl-item">
      <div class="tl-date">${fmtDate(p.taken_at)}</div>
      <div class="tl-photo"><img src="${p.photo_url}" loading="lazy" alt="${esc(displayName(cat))} on ${fmtDate(p.taken_at)}"></div>
      ${p.caption?`<div class="tl-caption">${esc(p.caption)}</div>`:''}
    </div>`).join('')}</div>` : `<div class="section-head"><span class="eyebrow">Photo trail</span><h2>Growth Timeline</h2></div><div class="empty">No growth photos have been logged for ${esc(displayName(cat))} yet. Check back soon.</div>`;

  const adoptBox = `
    <div class="adopt-box">
      <div class="lab">Interested in adopting ${esc(displayName(cat))}? Reach out to the shelter's adoption team — not the foster volunteer directly.${cat.animal_id?` Reference Animal ID #${esc(cat.animal_id)}.`:''}</div>
      <div class="adopt-actions">
        <a class="call" href="tel:9543591313">Call</a>
        <a class="mail" href="mailto:foster@broward.org?subject=${encodeURIComponent('Adoption inquiry: '+displayName(cat)+(cat.animal_id?' (ID '+cat.animal_id+')':''))}">Email</a>
      </div>
    </div>`;

  const statItems = [
    ['Status', cat.status==='adopted' ? 'Adopted' : 'Fostering'],
    cat.animal_id ? ['ID', esc(cat.animal_id)] : null,
    cat.breed ? ['Breed', esc(cat.breed)] : null,
    (cat.sex && cat.sex!=='unknown') ? ['Sex', esc(cat.sex.charAt(0).toUpperCase()+cat.sex.slice(1))] : null,
    cat.date_of_birth ? ['Birthdate', fmtDate(cat.date_of_birth)] : null
  ].filter(Boolean);
  const statList = `<ul class="stat-list">${statItems.map(([k,v])=>`<li><span class="k">${k}</span><span class="v">${v}</span></li>`).join('')}</ul>`;

  const fosterer = (profiles||[])[0];

  appEl.innerHTML = `
    <span class="back-link" data-home>&lsaquo; All kittens</span>
    <div class="profile-header">
      ${cat.cover_photo?`<img class="photo" src="${cat.cover_photo}" alt="${esc(displayName(cat))}">`:`<div class="ph">No photo</div>`}
      <div>
        <div class="pname">${esc(displayName(cat))}</div>
        ${statList}
        ${cat.bio?`<div class="pbio">${esc(cat.bio)}</div>`:''}
        ${fosterer?`<div class="cared">Cared for by ${esc(fosterer.display_name||'a Broward County foster volunteer')}</div>`:''}
      </div>
    </div>
    ${statCardsHTML(cat, weights||[])}
    ${adoptBox}
    ${timeline}
    ${littermatesHTML(cat, allCats||[])}
    ${aboutStripHTML()}
    ${await resourcesHTML()}
    ${siteEndHTML()}
  `;
  appEl.querySelector('[data-home]').addEventListener('click', ()=>{ location.hash=''; });
}

async function renderSignIn(){
  appEl.innerHTML = `<div class="spinner-wrap"><div class="spinner"></div></div>`;
  const { data, error } = await sb.auth.signInWithPassword({ email: 'huiwon.foster@example.com', password: 'demo' });
  if(!error){
    currentUser = data.user;
    renderNavAuth();
    location.hash = 'dashboard';
    return;
  }
  appEl.innerHTML = `
    <span class="back-link" data-home>&lsaquo; All kittens</span>
    <div class="auth-wrap">
      <h1>Sign In</h1>
      <p class="sub">Foster volunteers sign in here to see growth stats for their own kittens. Everyone else can browse the album without an account.</p>
      <div id="auth-error"></div>
      <form id="signin-form" novalidate>
        <div class="field">
          <label for="si-email">Email</label>
          <input id="si-email" type="email" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="si-password">Password</label>
          <input id="si-password" type="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="auth-submit">Sign In</button>
      </form>
      <div class="auth-hint">Demo preview &mdash; sign in as the seeded foster volunteer:<br><code>${esc(DEMO_EMAIL)}</code><br>(any password works in this preview)</div>
    </div>
  `;
  appEl.querySelector('[data-home]').addEventListener('click', ()=>{ location.hash=''; });
  appEl.querySelector('#signin-form').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const errHost = appEl.querySelector('#auth-error');
    errHost.innerHTML = '';
    const email = appEl.querySelector('#si-email').value;
    const password = appEl.querySelector('#si-password').value;
    const btn = appEl.querySelector('.auth-submit');
    btn.disabled = true; btn.textContent = 'Signing in…';
    const { data, error } = await sb.auth.signInWithPassword({ email, password });
    if(error){
      errHost.innerHTML = `<div class="auth-error">${esc(error.message)}</div>`;
      btn.disabled = false; btn.textContent = 'Sign In';
      return;
    }
    currentUser = data.user;
    renderNavAuth();
    location.hash = 'dashboard';
  });
}

function renderSignUp(){
  appEl.innerHTML = `
    <span class="back-link" data-home>&lsaquo; All kittens</span>
    <div class="auth-wrap">
      <h1>Create Account</h1>
      <p class="sub">Foster volunteers create an account to log their kittens' litters, photos and weigh-ins. Browsing the album never needs an account.</p>
      <div id="auth-error"></div>
      <form id="signup-form" novalidate>
        <div class="field">
          <label for="su-name">Your name</label>
          <input id="su-name" type="text" autocomplete="name">
        </div>
        <div class="field">
          <label for="su-email">Email</label>
          <input id="su-email" type="email" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="su-password">Password</label>
          <input id="su-password" type="password" autocomplete="new-password" required>
        </div>
        <button type="submit" class="auth-submit">Create Account</button>
      </form>
      <div class="auth-hint">Already fostering with us? <a href="#signin" style="color:var(--rose);">Sign in instead</a>.<br><span style="opacity:.8">Demo preview — accounts live only in this browser session.</span></div>
    </div>
  `;
  appEl.querySelector('[data-home]').addEventListener('click', ()=>{ location.hash=''; });
  appEl.querySelector('#signup-form').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const errHost = appEl.querySelector('#auth-error');
    errHost.innerHTML = '';
    const display_name = appEl.querySelector('#su-name').value;
    const email = appEl.querySelector('#su-email').value;
    const password = appEl.querySelector('#su-password').value;
    const btn = appEl.querySelector('.auth-submit');
    btn.disabled = true; btn.textContent = 'Creating…';
    const { data, error } = await sb.auth.signUp({ email, password, display_name });
    if(error){
      errHost.innerHTML = `<div class="auth-error">${esc(error.message)}</div>`;
      btn.disabled = false; btn.textContent = 'Create Account';
      return;
    }
    currentUser = data.user;
    renderNavAuth();
    location.hash = 'dashboard';
  });
}

function dashStatCardsHTML(cat, weights, photos){
  const ws = weights.filter(w=>w.cat_id===cat.id).sort((a,b)=> new Date(a.measured_at)-new Date(b.measured_at));
  const catPhotos = photos.filter(p=>p.cat_id===cat.id);
  const cards = [];
  const age = ageString(cat.date_of_birth);
  if(age) cards.push(`<div class="stat-card"><div class="num">${age.split(' ')[0]}</div><div class="lab">${age.split(' ').slice(1).join(' ')}</div></div>`);
  if(ws.length) cards.push(`<div class="stat-card"><div class="num">${ws[ws.length-1].weight_lb.toFixed(2)} lb</div><div class="lab">Current weight</div></div>`);
  if(ws.length>=2){
    const gain = ws[ws.length-1].weight_lb - ws[0].weight_lb;
    cards.push(`<div class="stat-card"><div class="num">+${gain.toFixed(2)} lb</div><div class="lab">Since intake</div></div>`);
  }
  const days = daysInCareString(cat.foster_start);
  if(days) cards.push(`<div class="stat-card"><div class="num">${days.split(' ')[0]}</div><div class="lab">Days in foster care</div></div>`);
  cards.push(`<div class="stat-card"><div class="num">${catPhotos.length}</div><div class="lab">Photos logged</div></div>`);
  return `<div class="stat-grid">${cards.join('')}</div>`;
}

/* ---- litter folder helpers ---- */
const openLitters = new Set();

function litterDisplayName(cats){
  const named = cats.slice(0,3).map(displayName).filter(Boolean);
  return named.length ? named.join(' & ') : 'New litter';
}
function catCover(c, photos){
  if(c.cover_photo) return c.cover_photo;
  const p = (photos||[]).find(ph=>ph.cat_id===c.id);
  return p ? p.photo_url : null;
}
function folderPreviewHTML(cats, photos){
  const shown = cats.slice(0,3);
  if(!shown.length) return `<div class="folder-preview"><div class="pv ph">No kittens yet — add one to start the album</div></div>`;
  const items = shown.map(c=>{
    const src = catCover(c, photos);
    return src ? `<div class="pv"><img src="${src}" alt="${esc(displayName(c))}"></div>` : `<div class="pv ph">No photo</div>`;
  }).join('');
  return `<div class="folder-preview">${items}</div>`;
}
function dashCatCardHTML(c, photos){
  const src = catCover(c, photos);
  const meta = c.status==='adopted' ? 'Adopted' : 'Fostering';
  return `<a class="lm-card" href="#cat=${c.id}">
    ${src?`<img src="${src}" alt="${esc(displayName(c))}">`:`<div class="ph">No photo</div>`}
    <div class="lm-name">${esc(displayName(c))}</div>
    <div class="lm-meta">${meta}</div>
  </a>`;
}
function dashCatFullHTML(cat, weights, photos){
  const statusTag = cat.status==='adopted' ? '<span class="tag sage">Adopted</span>' : '<span class="tag">Fostering</span>';
  const cw = weights.filter(w=>w.cat_id===cat.id);
  const svg = growthChartSVG(cw);
  return `<div class="dcat">
    <div class="drow">
      <h4>${esc(displayName(cat))}</h4>
      ${statusTag}
      <a class="view-link" href="#cat=${cat.id}">Full album &rsaquo;</a>
    </div>
    ${dashStatCardsHTML(cat, weights, photos)}
    <div class="mini-growth">${svg || '<div class="growth-note">Log a second weigh-in to draw the growth curve.</div>'}</div>
  </div>`;
}
function folderHTML(litter, cats, weights, photos){
  const open = openLitters.has(litter.id);
  return `<div class="folder${open?' open':''}" data-litter="${esc(litter.id)}">
    <div class="folder-head">
      <button class="folder-toggle" type="button" data-toggle aria-expanded="${open}">
        <span class="caret">&rsaquo;</span><span class="folder-name">${esc(litterDisplayName(cats))}</span>
      </button>
      <span class="tag sage">${cats.length} kitten${cats.length===1?'':'s'}</span>
    </div>
    ${folderPreviewHTML(cats, photos)}
    <div class="folder-actions">
      <button class="btn sm" type="button" data-upload-litter="${esc(litter.id)}">Upload photos</button>
      <button class="btn sm primary" type="button" data-add-kitten="${esc(litter.id)}">+ Add kitten</button>
    </div>
    <div class="folder-body">
      ${cats.length
        ? `<div class="littermates compact">${cats.map(c=>dashCatCardHTML(c, photos)).join('')}</div>`
        : `<div class="empty" style="padding:26px 8px;max-width:none">This litter has no kittens yet. Use <b style="color:var(--rose)">+ Add kitten</b> to add one, then upload its photos and weigh-ins.</div>`}
    </div>
  </div>`;
}

/* ---- modal infrastructure ---- */
function escClose(e){ if(e.key==='Escape') closeModal(); }
function closeModal(){
  const ov = document.getElementById('modal-overlay');
  if(ov) ov.remove();
  document.removeEventListener('keydown', escClose);
}
function openModal(inner){
  closeModal();
  const ov = document.createElement('div');
  ov.className = 'modal-overlay';
  ov.id = 'modal-overlay';
  ov.innerHTML = `<div class="modal">${inner}</div>`;
  document.body.appendChild(ov);
  ov.addEventListener('mousedown', e=>{ if(e.target===ov) closeModal(); });
  document.addEventListener('keydown', escClose);
  return ov;
}
function readFileAsDataURL(file){
  return new Promise((res,rej)=>{ const r=new FileReader(); r.onload=()=>res(r.result); r.onerror=rej; r.readAsDataURL(file); });
}

// Read the "date taken" out of a JPEG's EXIF metadata, so growth photos are
// dated by when they were actually shot rather than when they were uploaded.
// Returns 'YYYY-MM-DD' or null (no library needed — parses the APP1/TIFF block).
async function readPhotoDate(file){
  try{
    if(!file || (file.type && file.type!=='image/jpeg' && file.type!=='image/jpg')) return null;
    const buf = await file.arrayBuffer();
    const view = new DataView(buf);
    const len = view.byteLength;
    if(len < 4 || view.getUint16(0) !== 0xFFD8) return null; // not a JPEG
    let offset = 2;
    while(offset + 4 <= len){
      const marker = view.getUint16(offset);
      if((marker & 0xFF00) !== 0xFF00) break;      // not a marker boundary
      if(marker === 0xFFDA) break;                 // start of image data — no metadata past here
      const segLen = view.getUint16(offset + 2);
      if(segLen < 2) break;
      if(marker === 0xFFE1 && offset + 10 <= len &&
         view.getUint32(offset + 4) === 0x45786966 /* 'Exif' */ && view.getUint16(offset + 8) === 0x0000){
        const tiff = offset + 10;
        const little = view.getUint16(tiff) === 0x4949;
        const g16 = o => view.getUint16(o, little);
        const g32 = o => view.getUint32(o, little);
        if(g16(tiff + 2) !== 0x002A) return null;
        const ifd0 = tiff + g32(tiff + 4);
        const findTag = (ifd, tag) => {
          if(ifd + 2 > len) return -1;
          const count = g16(ifd);
          for(let i = 0; i < count; i++){
            const entry = ifd + 2 + i * 12;
            if(entry + 12 > len) break;
            if(g16(entry) === tag) return entry;
          }
          return -1;
        };
        const readAscii = entry => {
          const count = g32(entry + 4);
          let p = (count > 4) ? tiff + g32(entry + 8) : entry + 8;
          let s = '';
          for(let i = 0; i < count && p + i < len; i++){
            const c = view.getUint8(p + i);
            if(c === 0) break;
            s += String.fromCharCode(c);
          }
          return s;
        };
        let dateStr = null;
        const exifPtr = findTag(ifd0, 0x8769);        // Exif SubIFD pointer
        if(exifPtr >= 0){
          const exifIFD = tiff + g32(exifPtr + 8);
          let e = findTag(exifIFD, 0x9003);           // DateTimeOriginal
          if(e < 0) e = findTag(exifIFD, 0x9004);     // DateTimeDigitized
          if(e >= 0) dateStr = readAscii(e);
        }
        if(!dateStr){
          const e = findTag(ifd0, 0x0132);            // DateTime (file mod)
          if(e >= 0) dateStr = readAscii(e);
        }
        const m = dateStr && dateStr.match(/^(\d{4}):(\d{2}):(\d{2})/); // "YYYY:MM:DD HH:MM:SS"
        return m ? `${m[1]}-${m[2]}-${m[3]}` : null;
      }
      offset += 2 + segLen;
    }
    return null;
  }catch(_){ return null; }
}

/* ---- shared add-a-cat form helpers (breed dropdown + sex) ---- */
const CAT_BREEDS = [
  'Domestic Shorthair','Domestic Mediumhair','Domestic Longhair',
  'Tabby','Tuxedo','Calico','Tortoiseshell',
  'Siamese','Maine Coon','Persian','Ragdoll','Bengal','British Shorthair',
  'Russian Blue','Sphynx','Abyssinian','Scottish Fold','American Shorthair'
];
function breedOptionsHTML(selected){
  const inList = !!selected && CAT_BREEDS.includes(selected);
  const opts = ['<option value="">Select a breed…</option>'];
  CAT_BREEDS.forEach(b=>{ opts.push(`<option value="${esc(b)}"${b===selected?' selected':''}>${esc(b)}</option>`); });
  // Keep custom / legacy free-text descriptions selectable via "Other".
  opts.push(`<option value="__other__"${(selected && !inList)?' selected':''}>Other / mixed…</option>`);
  return opts.join('');
}
function sexOptionsHTML(selected){
  const s = selected || 'unknown';
  return ['unknown','male','female'].map(v=>{
    const label = v.charAt(0).toUpperCase()+v.slice(1);
    return `<option value="${v}"${v===s?' selected':''}>${label}</option>`;
  }).join('');
}
// Show the paired free-text input only when "Other" is chosen. `initialCustom`
// pre-selects "Other" and fills the text box (used when editing legacy breeds).
function wireBreedSelect(selectEl, otherEl, initialCustom){
  if(!selectEl || !otherEl) return;
  const sync = ()=>{ otherEl.style.display = selectEl.value==='__other__' ? '' : 'none'; };
  if(initialCustom){ selectEl.value='__other__'; otherEl.value=initialCustom; }
  selectEl.addEventListener('change', sync);
  sync();
}
// Resolve the chosen breed from a select + its "Other" text input.
function readBreed(selectEl, otherEl){
  if(!selectEl) return '';
  if(selectEl.value==='__other__') return otherEl ? (otherEl.value||'').trim() : '';
  return selectEl.value;
}

function openAddKittenModal(litterId){
  let coverData = null;
  const today = new Date().toISOString().slice(0,10);
  const ov = openModal(`
    <h2>Add a kitten</h2>
    <p class="mh">Add a kitten to this litter. You can log its photos and weigh-ins afterward.</p>
    <div id="ak-error"></div>
    <form id="ak-form" novalidate>
      <div class="field"><label for="ak-name">Name</label><input id="ak-name" type="text" placeholder="e.g. Milo — or leave blank to use an ID"></div>
      <div class="row2">
        <div class="field"><label for="ak-breed">Breed</label>
          <select id="ak-breed">${breedOptionsHTML('')}</select>
          <input id="ak-breed-other" type="text" placeholder="Describe the breed" style="display:none;margin-top:8px;">
        </div>
        <div class="field"><label for="ak-sex">Sex</label><select id="ak-sex">${sexOptionsHTML('')}</select></div>
      </div>
      <div class="row2">
        <div class="field"><label for="ak-dob">Date of birth</label><input id="ak-dob" type="date"></div>
        <div class="field"><label for="ak-start">Foster start</label><input id="ak-start" type="date" value="${today}"></div>
      </div>
      <div class="field"><label for="ak-id">Animal ID (optional)</label><input id="ak-id" type="text" placeholder="A2478000"></div>
      <div class="field"><label>Cover photo (optional)</label>
        <label class="file-drop" for="ak-photo"><b>Choose a photo</b> or drag one here</label>
        <input id="ak-photo" type="file" accept="image/*">
        <div class="file-preview" id="ak-preview"></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn ghost" data-cancel>Cancel</button>
        <button type="submit" class="btn primary">Add kitten</button>
      </div>
    </form>
  `);
  const fileInput = ov.querySelector('#ak-photo');
  fileInput.addEventListener('change', async ()=>{
    const f = fileInput.files[0];
    const prev = ov.querySelector('#ak-preview'); prev.innerHTML = '';
    if(f){ coverData = await readFileAsDataURL(f); prev.innerHTML = `<img src="${coverData}" alt="cover preview">`; }
  });
  wireBreedSelect(ov.querySelector('#ak-breed'), ov.querySelector('#ak-breed-other'));
  ov.querySelector('[data-cancel]').addEventListener('click', closeModal);
  ov.querySelector('#ak-form').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const name = ov.querySelector('#ak-name').value.trim();
    const breed = readBreed(ov.querySelector('#ak-breed'), ov.querySelector('#ak-breed-other'));
    const sex = ov.querySelector('#ak-sex').value;
    const dob = ov.querySelector('#ak-dob').value;
    const start = ov.querySelector('#ak-start').value;
    const animal_id = ov.querySelector('#ak-id').value.trim();
    await sb.from('cats').insert({
      fosterer_email: currentUser.email, litter_id: litterId,
      name: name || 'No Name', breed: breed || '', sex: sex || 'unknown', animal_id: animal_id || '',
      date_of_birth: dob || null, foster_start: start || null, status:'fostering',
      bio:'', cover_photo: coverData || null
    });
    openLitters.add(litterId);
    closeModal();
    renderDashboard();
  });
}

async function openUploadModal(preLitter, preCat, preMode){
  const [{ data: cats }, { data: litters }] = await Promise.all([
    sb.from('cats').select('*').eq('fosterer_email', currentUser.email),
    sb.from('litters').select('*').eq('fosterer_email', currentUser.email)
  ]);
  const myCats = cats || [];
  const litterIds = [];
  (litters||[]).forEach(l=>{ if(!litterIds.includes(l.id)) litterIds.push(l.id); });
  myCats.forEach(c=>{ if(c.litter_id && !litterIds.includes(c.litter_id)) litterIds.push(c.litter_id); });
  const litterOpts = litterIds.map(id=>{
    const lc = myCats.filter(c=>c.litter_id===id);
    return `<option value="${esc(id)}"${id===preLitter?' selected':''}>${esc(litterDisplayName(lc))}</option>`;
  }).join('');
  const today = new Date().toISOString().slice(0,10);
  let files = [];
  // Default to per-kitten upload, unless a specific kitten was requested.
  let mode = preCat ? 'cat' : (preMode==='litter' ? 'litter' : 'cat');
  const ov = openModal(`
    <h2>Upload photos</h2>
    <p class="mh">Add dated photos to a growth trail. Upload them to one kitten, or to every kitten in a litter at once.</p>
    <div id="up-error"></div>
    <form id="up-form" novalidate>
      <div class="field"><label>Photos</label>
        <label class="file-drop" for="up-files"><b>Choose photos</b> or drag them here</label>
        <input id="up-files" type="file" accept="image/*" multiple>
        <div class="file-preview" id="up-preview"></div>
      </div>
      <div class="field"><label>Upload by</label>
        <div class="seg" id="up-mode" role="tablist">
          <button type="button" data-mode="cat" class="${mode==='cat'?'active':''}">By kitten</button>
          <button type="button" data-mode="litter" class="${mode==='litter'?'active':''}">By litter</button>
        </div>
      </div>
      <div class="field"><label for="up-litter">Litter</label><select id="up-litter">${litterOpts || '<option value="">No litters yet</option>'}</select></div>
      <div class="field" id="up-cat-field"><label for="up-cat">Kitten</label><select id="up-cat"></select></div>
      <div class="field"><label for="up-date">Date taken</label><input id="up-date" type="date" value="${today}">
        <div class="field-note" id="up-date-note">Each photo is dated from its own metadata when available. This date is the fallback for photos without it.</div>
      </div>
      <div class="field"><label for="up-cap">Caption (optional)</label><textarea id="up-cap" placeholder="What's happening in these photos?"></textarea></div>
      <div class="modal-actions">
        <button type="button" class="btn ghost" data-cancel>Cancel</button>
        <button type="submit" class="btn primary">Upload</button>
      </div>
    </form>
  `);
  const litterSel = ov.querySelector('#up-litter');
  const catSel = ov.querySelector('#up-cat');
  const catField = ov.querySelector('#up-cat-field');
  function fillCats(){
    const lid = litterSel.value;
    const lc = myCats.filter(c=>c.litter_id===lid);
    catSel.innerHTML = lc.length
      ? lc.map(c=>`<option value="${esc(c.id)}"${c.id===preCat?' selected':''}>${esc(displayName(c))}</option>`).join('')
      : '<option value="">No kittens in this litter</option>';
  }
  function applyMode(){
    catField.style.display = mode==='cat' ? '' : 'none';
    ov.querySelectorAll('#up-mode button').forEach(b=>b.classList.toggle('active', b.dataset.mode===mode));
  }
  fillCats();
  applyMode();
  litterSel.addEventListener('change', fillCats);
  ov.querySelectorAll('#up-mode button').forEach(b=>{
    b.addEventListener('click', ()=>{ mode = b.dataset.mode; applyMode(); });
  });
  const filesInput = ov.querySelector('#up-files');
  const dateInput = ov.querySelector('#up-date');
  const dateNote = ov.querySelector('#up-date-note');
  filesInput.addEventListener('change', async ()=>{
    files = Array.from(filesInput.files || []);
    const prev = ov.querySelector('#up-preview'); prev.innerHTML = '';
    let withMeta = 0;
    for(const f of files){
      f._data = await readFileAsDataURL(f);
      f._exifDate = await readPhotoDate(f);
      if(f._exifDate) withMeta++;
      const tag = f._exifDate ? `<span class="pv-date">${esc(fmtDateShort(f._exifDate))}</span>` : '';
      prev.innerHTML += `<div class="pv-thumb"><img src="${f._data}" alt="preview">${tag}</div>`;
    }
    // If the photos carry their own dates, seed the fallback field with the earliest one.
    const dated = files.map(f=>f._exifDate).filter(Boolean).sort();
    if(dated.length) dateInput.value = dated[0];
    if(dateNote){
      dateNote.textContent = files.length
        ? (withMeta
            ? `Read the date from ${withMeta} of ${files.length} photo${files.length===1?'':'s'}. Photos without metadata use the date above.`
            : `No date metadata found in these photos — they'll all use the date above. (Tip: JPEGs straight from a camera or phone keep their capture date.)`)
        : `Each photo is dated from its own metadata when available. This date is the fallback for photos without it.`;
    }
  });
  ov.querySelector('[data-cancel]').addEventListener('click', closeModal);
  ov.querySelector('#up-form').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const errHost = ov.querySelector('#up-error');
    errHost.innerHTML = '';
    if(!files.length){ errHost.innerHTML = `<div class="auth-error">Choose at least one photo to upload.</div>`; return; }

    // Work out which kittens these photos belong to.
    let targetCats;
    if(mode==='litter'){
      const lid = litterSel.value;
      targetCats = myCats.filter(c=>c.litter_id===lid);
      if(!targetCats.length){ errHost.innerHTML = `<div class="auth-error">This litter has no kittens yet. Add a kitten to it first.</div>`; return; }
    } else {
      const catId = catSel.value;
      if(!catId){ errHost.innerHTML = `<div class="auth-error">Pick a kitten for these photos. If the litter is empty, add a kitten to it first.</div>`; return; }
      const theCat = myCats.find(c=>c.id===catId);
      targetCats = theCat ? [theCat] : [];
      if(!targetCats.length){ errHost.innerHTML = `<div class="auth-error">Pick a kitten for these photos.</div>`; return; }
    }

    const date = ov.querySelector('#up-date').value || today;
    const caption = ov.querySelector('#up-cap').value.trim();
    // Pre-read the files once (data URL + metadata date) so a "by litter"
    // upload doesn't re-read per kitten. Each photo keeps its own capture date.
    const items = [];
    for(const f of files){
      items.push({ url: f._data || await readFileAsDataURL(f), taken_at: f._exifDate || date });
    }

    for(const cat of targetCats){
      for(const it of items){
        await sb.from('photos').insert({ cat_id:cat.id, photo_url:it.url, taken_at:it.taken_at, caption });
      }
      if(!cat.cover_photo && items[0]){
        await sb.from('cats').update({ cover_photo: items[0].url }).eq('id', cat.id);
      }
      openLitters.add(cat.litter_id);
    }
    closeModal();
    renderDashboard();
  });
}

async function renderNewLitter(){
  if(!currentUser){
    const { data } = await sb.auth.getSession();
    currentUser = data.session ? data.session.user : null;
  }
  if(!currentUser){ location.hash = 'signin'; return; }

  const today = new Date().toISOString().slice(0,10);
  let kittenCount = 0; // running counter used to give each block unique field ids

  // Build the markup for a single kitten block.
  function kittenBlockHTML(n){
    return `
      <div class="kitten-block" data-kitten-block>
        <div class="kb-head">
          <span class="kb-title" data-kb-title>Kitten ${n}</span>
          <button type="button" class="kb-remove" data-kb-remove>Remove</button>
        </div>
        <div class="field"><label for="nl-name-${n}">Name</label><input id="nl-name-${n}" class="kb-name" type="text" placeholder="e.g. Milo — or leave blank to use an ID"></div>
        <div class="row2">
          <div class="field"><label for="nl-breed-${n}">Breed</label>
            <select id="nl-breed-${n}" class="kb-breed">${breedOptionsHTML('')}</select>
            <input class="kb-breed-other" type="text" placeholder="Describe the breed" style="display:none;margin-top:8px;">
          </div>
          <div class="field"><label for="nl-sex-${n}">Sex</label><select id="nl-sex-${n}" class="kb-sex">${sexOptionsHTML('')}</select></div>
        </div>
        <div class="row2">
          <div class="field"><label for="nl-dob-${n}">Date of birth</label><input id="nl-dob-${n}" class="kb-dob" type="date"></div>
          <div class="field"><label for="nl-start-${n}">Foster start</label><input id="nl-start-${n}" class="kb-start" type="date" value="${today}"></div>
        </div>
        <div class="field"><label for="nl-id-${n}">Animal ID (optional)</label><input id="nl-id-${n}" class="kb-id" type="text" placeholder="A2478000"></div>
        <div class="field"><label>Cover photo (optional)</label>
          <label class="file-drop" for="nl-photo-${n}"><b>Choose a photo</b> or drag one here</label>
          <input id="nl-photo-${n}" class="kb-photo" type="file" accept="image/*">
          <div class="file-preview kb-preview"></div>
        </div>
      </div>`;
  }

  // Wire up the file input + remove button on a freshly-added block.
  function wireBlock(block){
    const fileInput = block.querySelector('.kb-photo');
    fileInput.addEventListener('change', async ()=>{
      const f = fileInput.files[0];
      const prev = block.querySelector('.kb-preview'); prev.innerHTML = '';
      block._coverData = null;
      if(f){ block._coverData = await readFileAsDataURL(f); prev.innerHTML = `<img src="${block._coverData}" alt="cover preview">`; }
    });
    wireBreedSelect(block.querySelector('.kb-breed'), block.querySelector('.kb-breed-other'));
    block.querySelector('[data-kb-remove]').addEventListener('click', ()=>{
      block.remove();
      renumberBlocks();
    });
  }

  // Keep the "Kitten N" titles and Remove-button visibility in sync.
  function renumberBlocks(){
    const blocks = appEl.querySelectorAll('[data-kitten-block]');
    blocks.forEach((b,i)=>{ b.querySelector('[data-kb-title]').textContent = `Kitten ${i+1}`; });
    // Hide the Remove button when only one block remains.
    blocks.forEach(b=>{ b.querySelector('[data-kb-remove]').style.display = blocks.length>1 ? '' : 'none'; });
  }

  appEl.innerHTML = `
    <span class="back-link" data-back>&lsaquo; Back to My Cats</span>
    <div class="auth-wrap wide">
      <h1>Start a new litter</h1>
      <p class="sub">Create a litter folder and add all its kittens at once. Use <b style="color:var(--rose)">+ Add another kitten</b> to add more. You can still add photos and weigh-ins afterward. Leave a kitten's fields blank to skip it, or remove it to create an empty litter.</p>
      <div id="nl-error"></div>
      <form id="nl-form" novalidate>
        <div id="nl-kittens">${kittenBlockHTML(++kittenCount)}</div>
        <button type="button" class="add-kitten-btn" id="nl-add-kitten">+ Add another kitten</button>
        <div class="modal-actions">
          <button type="button" class="btn ghost" data-cancel>Cancel</button>
          <button type="submit" class="btn primary">Create litter</button>
        </div>
      </form>
    </div>
    ${siteEndHTML()}
  `;
  appEl.querySelector('[data-back]').addEventListener('click', ()=>{ location.hash='dashboard'; });
  appEl.querySelector('[data-cancel]').addEventListener('click', ()=>{ location.hash='dashboard'; });

  const kittensWrap = appEl.querySelector('#nl-kittens');
  wireBlock(kittensWrap.querySelector('[data-kitten-block]'));
  renumberBlocks();

  appEl.querySelector('#nl-add-kitten').addEventListener('click', ()=>{
    kittensWrap.insertAdjacentHTML('beforeend', kittenBlockHTML(++kittenCount));
    const block = kittensWrap.lastElementChild;
    wireBlock(block);
    renumberBlocks();
    block.querySelector('.kb-name').focus();
    block.scrollIntoView({ behavior:'smooth', block:'center' });
  });

  appEl.querySelector('#nl-form').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const btn = appEl.querySelector('#nl-form .btn.primary');
    btn.disabled = true; btn.textContent = 'Creating…';
    const id = 'L' + Date.now().toString(36);
    await sb.from('litters').insert({ id, fosterer_email: currentUser.email });

    // Collect every kitten block that has something filled in.
    const rows = [];
    appEl.querySelectorAll('[data-kitten-block]').forEach(block=>{
      const name = block.querySelector('.kb-name').value.trim();
      const breed = readBreed(block.querySelector('.kb-breed'), block.querySelector('.kb-breed-other'));
      const sex = block.querySelector('.kb-sex').value;
      const dob = block.querySelector('.kb-dob').value;
      const start = block.querySelector('.kb-start').value;
      const animal_id = block.querySelector('.kb-id').value.trim();
      const coverData = block._coverData || null;
      if(name || breed || dob || animal_id || coverData){
        rows.push({
          fosterer_email: currentUser.email, litter_id: id,
          name: name || 'No Name', breed: breed || '', sex: sex || 'unknown', animal_id: animal_id || '',
          date_of_birth: dob || null, foster_start: start || null, status:'fostering',
          bio:'', cover_photo: coverData || null
        });
      }
    });
    if(rows.length){ await sb.from('cats').insert(rows); }

    openLitters.add(id);
    location.hash = 'dashboard';
  });
}

async function renderDashboard(){
  appEl.innerHTML = `<div class="spinner-wrap"><div class="spinner"></div></div>`;
  if(!currentUser){
    const { data } = await sb.auth.getSession();
    currentUser = data.session ? data.session.user : null;
  }
  if(!currentUser){ location.hash = 'signin'; return; }

  const [{ data: cats }, { data: photos }, { data: weights }, { data: profiles }, { data: litters }] = await Promise.all([
    sb.from('cats').select('*').eq('fosterer_email', currentUser.email).order('created_at', { ascending:false }),
    sb.from('photos').select('*'),
    sb.from('weights').select('*'),
    sb.from('profiles').select('*').eq('email', currentUser.email),
    sb.from('litters').select('*').eq('fosterer_email', currentUser.email)
  ]);

  const myCats = cats || [];
  const myCatIds = new Set(myCats.map(c=>c.id));
  const myPhotos = (photos||[]).filter(p=>myCatIds.has(p.cat_id));
  const myWeights = (weights||[]).filter(w=>myCatIds.has(w.cat_id));
  const profile = (profiles||[])[0];

  const litterRows = (litters||[]).slice();
  const seen = new Set(litterRows.map(l=>l.id));
  const byLitter = new Map();
  myCats.forEach(c=>{
    const id = c.litter_id || ('solo-'+c.id);
    if(!byLitter.has(id)) byLitter.set(id, []);
    byLitter.get(id).push(c);
    if(!seen.has(id)){ litterRows.push({ id, fosterer_email: currentUser.email }); seen.add(id); }
  });

  const folders = litterRows.length
    ? `<div class="folder-grid">${litterRows.map(l=>folderHTML(l, byLitter.get(l.id)||[], myWeights, myPhotos)).join('')}</div>`
    : `<div class="empty">No litters yet. Use <b style="color:var(--rose)">+ Add litter</b> to create your first one, then add the kittens in it.</div>`;

  appEl.innerHTML = `
    <span class="back-link" data-home>&lsaquo; Public growth album</span>
    <header class="home-head">
      <div class="hh-text">
        <span class="label">Signed in as ${esc(profile?.display_name || currentUser.email)}</span>
        <h1>My Cats</h1>
        <p class="sub">Your litters, foldered by intake. Open a folder to see each kitten's full growth stats, or log new photos.</p>
      </div>
      <div class="hh-stats tag-strip">${heroStatsHTML(myCats, myPhotos, myWeights)}</div>
    </header>
    <div class="dash-actions">
      <button class="circle-btn" type="button" id="add-litter">
        <span class="circle" aria-hidden="true">+</span>
        <span class="clabel">Add litter</span>
      </button>
      <button class="circle-btn ghost" type="button" id="upload-photos">
        <span class="circle" aria-hidden="true">&#128247;</span>
        <span class="clabel">Upload photos</span>
      </button>
    </div>
    ${folders}
    ${siteEndHTML()}
  `;

  appEl.querySelector('[data-home]').addEventListener('click', ()=>{ location.hash=''; });
  appEl.querySelector('#add-litter').addEventListener('click', ()=>{ location.hash='new-litter'; });
  appEl.querySelector('#upload-photos').addEventListener('click', ()=>openUploadModal());
  appEl.querySelectorAll('[data-toggle]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const folder = btn.closest('.folder');
      const id = folder.dataset.litter;
      const nowOpen = folder.classList.toggle('open');
      btn.setAttribute('aria-expanded', nowOpen);
      if(nowOpen) openLitters.add(id); else openLitters.delete(id);
    });
  });
  appEl.querySelectorAll('[data-add-kitten]').forEach(btn=>{
    btn.addEventListener('click', ()=>openAddKittenModal(btn.dataset.addKitten));
  });
  appEl.querySelectorAll('[data-upload-litter]').forEach(btn=>{
    btn.addEventListener('click', ()=>openUploadModal(btn.dataset.uploadLitter, null, 'litter'));
  });
}

function renderNavAuth(){
  const host = document.getElementById('nav-auth');
  if(!host) return;
  if(currentUser){
    host.innerHTML = `<a class="nav-btn" href="#dashboard">My Cats</a><button class="nav-btn" id="nav-signout" type="button">Sign Out</button>`;
    host.querySelector('#nav-signout').addEventListener('click', async ()=>{
      await sb.auth.signOut();
      currentUser = null;
      renderNavAuth();
      location.hash = '';
    });
  } else {
    host.innerHTML = `<button class="nav-btn" id="nav-signin" type="button">Sign In</button><a class="nav-btn primary" href="#signup">Sign Up</a>`;
    host.querySelector('#nav-signin').addEventListener('click', async ()=>{
      const { data, error } = await sb.auth.signInWithPassword({ email: 'huiwon.foster@example.com', password: 'demo' });
      if(error) return;
      currentUser = data.user;
      renderNavAuth();
      location.hash = 'dashboard';
    });
  }
}

function getCatIdFromHash(){
  const m = location.hash.match(/^#cat=(.+)$/);
  return m ? m[1] : null;
}
function route(){
  const hash = location.hash;
  if(hash === '#signin'){
    renderSignIn();
  } else if(hash === '#signup'){
    renderSignUp();
  } else if(hash === '#dashboard'){
    renderDashboard();
  } else if(hash === '#new-litter'){
    renderNewLitter();
  } else {
    const catId = getCatIdFromHash();
    if(catId) renderDetail(catId);
    else renderList();
  }
  renderNavAuth();
  window.scrollTo({top:0, behavior:'auto'});
}
document.querySelector('[data-home]')?.addEventListener('click', ()=>{ location.hash=''; if(!getCatIdFromHash()) route(); });
window.addEventListener('hashchange', route);
(async function initAuth(){
  const { data } = await sb.auth.getSession();
  currentUser = data.session ? data.session.user : null;
  renderNavAuth();
})();
route();
</script>
</body>
</html>
