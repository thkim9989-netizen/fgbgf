  function query(table){
    let filters = [];
    let singleMode = null;
    let orderKey = null, orderAsc = true;
    const self = {
      select(){ return self; },
      eq(k,v){ filters.push(r=>String(r[k]).toLowerCase()===String(v).toLowerCase()); return self; },
      in(k,arr){ filters.push(r=>arr.includes(r[k])); return self; },
      order(k,opts){ orderKey=k; orderAsc = !opts || opts.ascending!==false; return self; },
      single(){ singleMode='single'; return self; },
      maybeSingle(){ singleMode='maybeSingle'; return self; },
      insert(payload){
        const rows = Array.isArray(payload)?payload:[payload];
        rows.forEach(r=>{ if(!r.id) r.id='id-'+Math.random().toString(36).slice(2,10); if(!r.created_at) r.created_at=new Date().toISOString(); DB[table].push(r); });
        return Promise.resolve({data:rows[0], error:null});
      },
      upsert(payload){
        const idx = DB[table].findIndex(r=>r.id===payload.id);
        if(idx>=0) DB[table][idx] = Object.assign({}, DB[table][idx], payload);
        else DB[table].push(payload);
        return Promise.resolve({data:payload, error:null});
      },
      update(payload){
        return { eq:(k,v)=>{ DB[table].filter(r=>r[k]===v).forEach(r=>Object.assign(r,payload)); return Promise.resolve({data:payload,error:null}); } };
      },
      delete(){
        return { eq:(k,v)=>{ DB[table] = DB[table].filter(r=>r[k]!==v); return Promise.resolve({data:null,error:null}); } };
      },
      then(resolve){
        let rows = DB[table].filter(r=>filters.every(f=>f(r)));
        if(orderKey) rows = rows.slice().sort((a,b)=>{
          if(a[orderKey]===b[orderKey]) return 0;
          const gt = a[orderKey] > b[orderKey];
          return orderAsc ? (gt?1:-1) : (gt?-1:1);
        });
        let result = rows;
        if(singleMode==='single') result = rows[0];
        if(singleMode==='maybeSingle') result = rows[0] || null;
        resolve({data:result, error:null});
      }
    };
    return self;
  }

  window.supabase = {
    createClient: function(){
      return {
        auth:{
          getSession: async ()=>({data:{session}}),
          signInWithPassword: async ({email, password}={})=>{
            const clean = String(email||'').trim().toLowerCase();
            const profile = DB.profiles.find(p=>p.email.toLowerCase()===clean);
            if(!profile) return { data:{ user:null, session:null }, error:{ message:"We couldn't find a foster account with that email in this preview." } };
            if(!password) return { data:{ user:null, session:null }, error:{ message:'Enter a password to continue.' } };
            session = { user:{ id:profile.id, email:profile.email } };
            return { data:{ user:session.user, session }, error:null };
          },
          signUp: async ({email, password, display_name}={})=>{
            const clean = String(email||'').trim().toLowerCase();
            if(!clean || !clean.includes('@')) return { data:{ user:null, session:null }, error:{ message:'Enter a valid email address.' } };
            if(!password) return { data:{ user:null, session:null }, error:{ message:'Choose a password to create your account.' } };
            let profile = DB.profiles.find(p=>p.email.toLowerCase()===clean);
            if(!profile){
              profile = { id:'user-'+Math.random().toString(36).slice(2,9), email:clean, display_name:(display_name||'').trim()||clean.split('@')[0], contact_phone:'', contact_email:'' };
              DB.profiles.push(profile);
            }
            session = { user:{ id:profile.id, email:profile.email } };
            return { data:{ user:session.user, session }, error:null };
          },
          signOut: async ()=>{ session = null; return { error:null }; }
        },
        from: query,
        storage:{
          from(){
            return {
              upload: async ()=>({error:null}),
              getPublicUrl(){ return { data:{ publicUrl: ph('%23ffd9e5','new') } }; },
              remove: async ()=>({error:null})
            };
          }
        }
      };
    }
  };
})();
